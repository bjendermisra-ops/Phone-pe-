                "err_name": "कृपया एक वैध पूरा नाम दर्ज करें!", "err_phone": "कृपया 10-अंकीय वैध मोबाइल नंबर दर्ज करें!",
                "err_email": "कृपया एक वैध ईमेल पता दर्ज करें!", "err_pan": "कृपया एक वैध 10-अंकीय पैन नंबर दर्ज करें!",
                "err_address": "कृपया एक वैध पूरा पता दर्ज करें!", "err_state": "कृपया एक वैध राज्य दर्ज करें!",
                "err_city": "कृपया एक वैध शहर दर्ज करें!", "err_pincode": "कृपया एक वैध 6-अंकीय पिन कोड दर्ज करें!"
            },
            "mr": {
                "header_title": "दान सेवा", "tab_all": "सर्व", "tab_gau": "गौ सेवा", "tab_temple": "मंदिर सेवा", "tab_annadan": "अन्नदान",
                "btn_donate": "दान करा ❤", "card1_title": "गौ सेवा आणि चारा (गौ पोषण)", "card1_desc": "प्यारी गायींना प्रेमपूर्वक भोजन द्या. तुमचा प्रसाद दररोज ९०+ पवित्र गायींना पोषण देतो.",
                "card2_title": "गौ वैद्यकीय उपचार (गौ चिकित्सा)", "card2_desc": "जखमी आणि आजारी गायींसाठी तातडीची वैद्यकीय मदत, नियमित तपासणी आणि उपचारांना हातभार लावा.",
                "card3_title": "संगमरमर सेवा प्रायोजित करा", "card3_desc": "संगमरमर प्रायोजित करून, तुम्ही त्या पवित्र मजल्यांचे आणि वेदींचे सुशोभीकरण करण्यास मदत करता.",
                "card4_title": "एकादशी विशेष सेवा (अन्नदान)", "card4_desc": "उपवास करणाऱ्या यात्रेकरूंसाठी आणि भक्तांसाठी विशेष धान्य-मुक्त भोजन प्रायोजित करा.",
                "view_live": "थेट दान पहा", "modal_amt_title": "दान रक्कम निवडा", "modal_proceed_info": "दाता माहितीवर जा",
                "modal_donor_title": "दाता माहिती", "label_name": "पूर्ण नाव*", "label_phone": "मोबाईल नंबर*", "label_email": "ईमेल पत्ता",
                "btn_payment": "पैसे भरण्यासाठी पुढे जा", "btn_back": "मागे", "btn_close": "बंद करा", "modal_recent_title": "थेट देणग्यांची यादी",
                "no_donations": "अद्याप देणग्या नाहीत!", "share_title": "ही सेवा शेअर करा", "link_copied": "थेट सेवा लिंक कॉपी झाली आहे! ती व्हॉट्सॲपवर शेअर करा।",
                "modal_tax_checkbox": "मला 10BE (आयकर लाभ) पावती हवी", "modal_tax_subtext": "तुमच्या सर्व देणग्यांसाठी कर-वजावट योग्य पावत्या मिळवा",
                "modal_label_pan": "पॅन नंबर*", "modal_label_address": "पत्ता*", "modal_label_country": "देश*", "modal_label_state": "राज्य*",
                "modal_label_city": "शहर*", "modal_label_pincode": "पिन कोड*",
                "err_name": "कृपया वैध पूर्ण नाव प्रविष्ट करा!", "err_phone": "कृपया 10-अंकी वैध मोबाईल नंबर प्रविष्ट करा!",
                "err_email": "कृपया वैध ईमेल पत्ता प्रविष्ट करा!", "err_pan": "कृपया वैध 10-अंकी पॅन नंबर प्रविष्ट करा!",
                "err_address": "कृपया वैध पत्ता प्रविष्ट करा!", "err_state": "कृपया वैध राज्य प्रविष्ट करा!",
                "err_city": "कृपया वैध शहर प्रविष्ट करा!", "err_pincode": "कृपया वैध 6-अंकी पिन कोड प्रविष्ट करा!"
            }
        };

        const firebaseConfig = {
            apiKey: "AIzaSyAHksBlu9ue2p7AxXuUKALmEws5mscO908",
            authDomain: "iskcon-bhuvaikuntha.firebaseapp.com",
            projectId: "iskcon-bhuvaikuntha",
            storageBucket: "iskcon-bhuvaikuntha.firebasestorage.app",
            messagingSenderId: "87535383708",
            appId: "1:87535383708:web:7548e3b7d4c807faafe959",
            measurementId: "G-ZWEB9HM0K4"
        };
        firebase.initializeApp(firebaseConfig);
        const db = firebase.firestore();

        let currentSeva = '', currentSevaId = '', selectedAmt = 500, globalLiveDonations = [];

        window.addEventListener('DOMContentLoaded', () => {
            const savedLang = localStorage.getItem('lang') || 'en';
            setLanguage(savedLang);
            startLiveDonationsListener();
            syncStateFromURL();
            setupInputSecurityListeners();
            checkPaymentSuccessCallback();
        });

        // =====================================
        // CALLBACK, FIREBASE SYNC & WHATSAPP
        // =====================================
        function checkPaymentSuccessCallback() {
            const urlParams = new URLSearchParams(window.location.search);
            const status = urlParams.get('status');
            const name = urlParams.get('name');
            const amount = urlParams.get('amount');
            const seva = urlParams.get('seva');
            const phone = urlParams.get('phone');
            const txId = urlParams.get('transactionId');
            
            // Fetching 10BE Data
            const pan = urlParams.get('pan');
            const address = urlParams.get('address');

            if (status === 'success' && txId && amount) {
                if (localStorage.getItem(txId) === 'true') {
                    showSuccessReceiptScreen(name, amount, seva, phone, txId);
                    return;
                }

                showToast("Processing & Syncing Donation Securely...");

                db.collection("donations").doc(txId).set({
                    name: name ? decodeURIComponent(name) : 'Anonymous Donor',
                    amount: Number(amount),
                    seva: seva ? decodeURIComponent(seva) : 'General Donation',
                    paymentId: txId,
                    contact: phone || 'N/A',
                    pan: pan ? decodeURIComponent(pan) : 'N/A',
                    address: address ? decodeURIComponent(address) : 'N/A',
                    date: firebase.firestore.FieldValue.serverTimestamp()
                })
                .then(() => {
                    localStorage.setItem(txId, 'true');
                    showSuccessReceiptScreen(name, amount, seva, phone, txId);
                    showToast("Donation Synced Successfully!");

                    if (phone && phone !== 'N/A') {
                        const fetchBase = window.location.protocol === 'file:' ? 'https://phone-pe-pi.vercel.app' : '';

                        fetch(`${fetchBase}/api/send-whatsapp-receipt`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                phone: phone,
                                name: decodeURIComponent(name),
                                amount: amount,
                                seva: decodeURIComponent(seva),
                                transactionId: txId,
                                pan: pan ? decodeURIComponent(pan) : '',
                                address: address ? decodeURIComponent(address) : ''
                            })
                        }).catch(err => console.error("WHATSAPP Trigger error:", err));
                    }
                })
                .catch((error) => alert("Database write error: " + error.message));
            }
        }

        function showSuccessReceiptScreen(name, amount, seva, phone, txId) {
            document.getElementById('r-name').innerText = decodeURIComponent(name || 'Donor');
            document.getElementById('r-amt').innerText = '₹' + amount + '/-';
            document.getElementById('r-seva').innerText = decodeURIComponent(seva || 'General Donation');
            document.getElementById('r-txid').innerText = txId;
            document.getElementById('r-phone').innerText = phone || 'N/A';
            document.getElementById('r-method').innerText = 'PHONEPE V2';
            const now = new Date();
            document.getElementById('r-time').innerText = now.toLocaleDateString('en-IN') + ', ' + now.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
            document.getElementById('success-modal').classList.remove('hidden');
        }

        window.addEventListener('storage', (event) => { if (event.key === 'lang') setLanguage(event.newValue || 'en'); });
        window.addEventListener('popstate', () => syncStateFromURL());

        function setFieldError(inputId, errorId, isValid, errorMessage) {
            const inputEl = document.getElementById(inputId), errorEl = document.getElementById(errorId);
            if (inputEl && errorEl) {
                if (!isValid) { inputEl.classList.add('input-error'); errorEl.innerText = errorMessage; errorEl.classList.remove('hidden'); } 
                else { inputEl.classList.remove('input-error'); errorEl.classList.add('hidden'); }
            }
        }

        function clearErrorOnInput(inputId, errorId) {
            const inputEl = document.getElementById(inputId);
            if (inputEl) {
                inputEl.addEventListener('input', () => {
                    inputEl.classList.remove('input-error');
                    const errorEl = document.getElementById(errorId);
                    if (errorEl) errorEl.classList.add('hidden');
                });
            }
        }

        function setupInputSecurityListeners() {
            clearErrorOnInput('donor-name', 'error-name'); clearErrorOnInput('donor-phone', 'error-phone');
            clearErrorOnInput('donor-email', 'error-email'); clearErrorOnInput('pan-number', 'error-pan');
            clearErrorOnInput('address', 'error-address'); clearErrorOnInput('state', 'error-state');
            clearErrorOnInput('city', 'error-city'); clearErrorOnInput('pincode', 'error-pincode');
            document.getElementById('donor-name').addEventListener('input', (e) => { e.target.value = e.target.value.replace(/[^a-zA-Z\s]/g, '').slice(0, 50); });
            document.getElementById('donor-phone').addEventListener('input', (e) => { e.target.value = e.target.value.replace(/\D/g, '').slice(0, 10); });
            document.getElementById('donor-email').addEventListener('input', (e) => { e.target.value = e.target.value.replace(/[^a-zA-Z0-9@._-]/g, '').slice(0, 80); });
            document.getElementById('pan-number').addEventListener('input', (e) => { e.target.value = e.target.value.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 10); });
            document.getElementById('address').addEventListener('input', (e) => { e.target.value = e.target.value.replace(/[<>\/\\'"`;]/g, '').slice(0, 150); });
            document.getElementById('state').addEventListener('input', (e) => { e.target.value = e.target.value.replace(/[^a-zA-Z\s]/g, '').slice(0, 30); });
            document.getElementById('city').addEventListener('input', (e) => { e.target.value = e.target.value.replace(/[^a-zA-Z\s]/g, '').slice(0, 30); });
            document.getElementById('pincode').addEventListener('input', (e) => { e.target.value = e.target.value.replace(/\D/g, '').slice(0, 6); });
        }

        function setLanguage(lang) {
            localStorage.setItem('lang', lang);
            const texts = langData[lang];
            document.querySelectorAll('[data-key]').forEach(el => {
                const key = el.getAttribute('data-key');
                if (texts[key]) {
                    if (key === 'view_live') el.innerHTML = '<span class="live-pulse-dot"></span> 👥 ' + texts[key];
                    else el.innerText = texts[key];
                }
            });
            document.querySelectorAll('.lang-chip').forEach(chip => chip.classList.remove('active'));
            const activeChip = document.getElementById('chip-' + lang);
            if (activeChip) activeChip.classList.add('active');
            const headerTitle = document.getElementById('title-donate-now');
            if (headerTitle && texts["header_title"]) headerTitle.innerText = texts["header_title"];
        }

        function startLiveDonationsListener() {
            db.collection("donations").orderBy("date", "desc").limit(30).onSnapshot((snapshot) => {
                globalLiveDonations = [];
                snapshot.forEach((doc) => {
                    const data = doc.data();
                    let dateVal = '';
                    if (data.date) {
                        const tDate = data.date.toDate ? data.date.toDate() : new Date(data.date);
                        dateVal = tDate.toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true });
                    }
                    globalLiveDonations.push({ name: data.name || 'Anonymous', amount: data.amount || 0, date: dateVal });
                });
            });
        }

        function getCategoryQuerySlug(category) {
            const clean = category.toLowerCase().trim();
            if (clean.includes('gau') || clean.includes('poshana') || clean.includes('cow')) return 'gau';
            if (clean.includes('temple') || clean.includes('marble')) return 'temple';
            if (clean.includes('annadan') || clean.includes('ekadashi')) return 'annadan';
            return 'all';
        }

        function getCategoryFromSlug(slug) {
            if (!slug) return 'All';
            const clean = slug.toLowerCase().trim();
            if (clean === 'gau' || clean === 'gau-seva') return 'Gau Seva';
            if (clean === 'temple' || clean === 'marble') return 'Temple';
            if (clean === 'annadan' || clean === 'ekadashi') return 'Annadan';
            return 'All';
        }

        function updateURL(category, sevaId = '') {
            const url = new URL(window.location.href);
            const slug = getCategoryQuerySlug(category);
            if (slug === 'all') url.searchParams.delete('category'); else url.searchParams.set('category', slug);
            if (sevaId) url.searchParams.set('seva', sevaId); else url.searchParams.delete('seva');
            window.history.pushState({ category, sevaId }, '', url.toString());
        }

        function syncStateFromURL() {
            const urlParams = new URLSearchParams(window.location.search);
            const categoryParam = urlParams.get('category'), sevaParam = urlParams.get('seva');
            if (categoryParam) filterCategory(getCategoryFromSlug(categoryParam), false); else filterCategory('All', false);
            if (sevaParam) {
                setTimeout(() => {
                    const element = document.getElementById(`seva-card-${sevaParam}`);
                    if (element) {
                        element.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        element.style.outline = '3px solid var(--primary-color)';
                        element.style.outlineOffset = '2px';
                        element.style.borderRadius = '12px';
                        setTimeout(() => element.style.outline = 'none', 3500);
                    }
                }, 400);
            }
        }

        function copySevaLink(sevaId, category) {
            const url = new URL(window.location.origin + window.location.pathname);
            url.searchParams.set('category', getCategoryQuerySlug(category));
            url.searchParams.set('seva', sevaId);
            navigator.clipboard.writeText(url.toString()).then(() => {
                const lang = localStorage.getItem('lang') || 'en';
                showToast(langData[lang]["link_copied"] || "Direct Seva link copied!");
            });
        }

        function filterCategory(category, updateHistory = true) {
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            if (category === 'All') document.getElementById('tab-all').classList.add('active');
            if (category === 'Gau Seva') document.getElementById('tab-gau').classList.add('active');
            if (category === 'Temple') document.getElementById('tab-temple').classList.add('active');
            if (category === 'Annadan') document.getElementById('tab-annadan').classList.add('active');
            document.querySelectorAll('.seva-card').forEach(card => {
                if (category === 'All' || card.getAttribute('data-category') === category) card.classList.remove('hidden');
                else card.classList.add('hidden');
            });
            if (updateHistory) updateURL(category);
        }

        function openAmountModal(sevaName, sevaId = '') {
            currentSeva = sevaName; currentSevaId = sevaId;
            document.getElementById('selected-seva-title').innerText = sevaName;
            document.getElementById('step-amount').classList.remove('hidden');
            document.getElementById('step-form').classList.add('hidden');
            document.getElementById('payment-modal').classList.remove('hidden');
            const activeTab = document.querySelector('.tab.active');
            updateURL(activeTab ? getCategoryFromSlug(activeTab.id.replace('tab-', '')) : 'All', sevaId);
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
            if (id === 'payment-modal' || id === 'success-modal') {
                const taxCb = document.getElementById('tax-benefit');
                if (taxCb) { taxCb.checked = false; toggleTaxFields(false); }
                document.querySelectorAll('input').forEach(input => input.classList.remove('input-error'));
                document.querySelectorAll('.error-msg').forEach(err => err.classList.add('hidden'));
                const activeTab = document.querySelector('.tab.active');
                updateURL(activeTab ? getCategoryFromSlug(activeTab.id.replace('tab-', '')) : 'All');
            }
        }

        function selectAmount(amount, element) {
            document.querySelectorAll('.amt-btn').forEach(btn => btn.classList.remove('selected'));
            element.classList.add('selected');
            if (amount === 0) { document.getElementById('custom-amount').classList.remove('hidden'); selectedAmt = 0; } 
            else { document.getElementById('custom-amount').classList.add('hidden'); selectedAmt = amount; }
        }

        function updateCustomAmount(val) { selectedAmt = Number(val); }

        function goToDonorInfo() {
            if (selectedAmt <= 0) { alert('Please enter valid amount!'); return; }
            document.getElementById('step-amount').classList.add('hidden');
            document.getElementById('step-form').classList.remove('hidden');
        }

        function backToAmount() {
            document.getElementById('step-form').classList.add('hidden');
            document.getElementById('step-amount').classList.remove('hidden');
        }

        function toggleTaxFields(checked) {
            const taxFields = document.getElementById('tax-fields');
            const inputs = taxFields.querySelectorAll('input');
            if (checked) {
                taxFields.classList.remove('hidden');
                inputs.forEach(i => { if(i.id !== 'country' && i.id !== 'donor-email') i.required = true; });
            } else {
                taxFields.classList.add('hidden');
                inputs.forEach(i => i.required = false);
            }
        }

        // =====================================
        // GATEWAY LINK GENERATION
        // =====================================
        async function generateSecurePaymentLink() {
            const nameInput = document.getElementById('donor-name'), phoneInput = document.getElementById('donor-phone'), emailInput = document.getElementById('donor-email');
            const name = nameInput.value.trim(), phone = phoneInput.value.trim(), email = emailInput.value.trim();
            const isTaxRequired = document.getElementById('tax-benefit').checked;
            
            const lang = localStorage.getItem('lang') || 'en';
            let hasError = false, firstEl = null;

            const isNameValid = name && name.length >= 3;
            setFieldError('donor-name', 'error-name', isNameValid, langData[lang]["err_name"]);
            if (!isNameValid) { hasError = true; if(!firstEl) firstEl = nameInput; }

            const isPhoneValid = phone && phone.length === 10 && /^[6-9]\d{9}$/.test(phone);
            setFieldError('donor-phone', 'error-phone', isPhoneValid, langData[lang]["err_phone"]);
            if (!isPhoneValid) { hasError = true; if(!firstEl) firstEl = phoneInput; }

            let isEmailValid = true;
            if (email) isEmailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
            setFieldError('donor-email', 'error-email', isEmailValid, langData[lang]["err_email"]);
            if (!isEmailValid) { hasError = true; if(!firstEl) firstEl = emailInput; }

            let finalPan = '', finalAddress = '';

            if (isTaxRequired) {
                const panInput = document.getElementById('pan-number'), addrInput = document.getElementById('address'), stateInput = document.getElementById('state'), cityInput = document.getElementById('city'), pinInput = document.getElementById('pincode');
                const panVal = panInput.value.trim(), addrVal = addrInput.value.trim(), stateVal = stateInput.value.trim(), cityVal = cityInput.value.trim(), pinVal = pinInput.value.trim();

                const isPanValid = /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/.test(panVal);
                setFieldError('pan-number', 'error-pan', isPanValid, langData[lang]["err_pan"]);
                if (!isPanValid) { hasError=true; if(!firstEl) firstEl = panInput; }

                const isAddrValid = addrVal.length >= 5;
                setFieldError('address', 'error-address', isAddrValid, langData[lang]["err_address"]);
                if (!isAddrValid) { hasError=true; if(!firstEl) firstEl = addrInput; }

                const isStateValid = stateVal.length >= 2;
                setFieldError('state', 'error-state', isStateValid, langData[lang]["err_state"]);
                if (!isStateValid) { hasError=true; if(!firstEl) firstEl = stateInput; }

                const isCityValid = cityVal.length >= 2;
                setFieldError('city', 'error-city', isCityValid, langData[lang]["err_city"]);
                if (!isCityValid) { hasError=true; if(!firstEl) firstEl = cityInput; }

                const isPinValid = /^\d{6}$/.test(pinVal);
                setFieldError('pincode', 'error-pincode', isPinValid, langData[lang]["err_pincode"]);
                if (!isPinValid) { hasError=true; if(!firstEl) firstEl = pinInput; }

                if(!hasError) {
                    finalPan = panVal;
                    finalAddress = `${addrVal}, ${cityVal}, ${stateVal} - ${pinVal}, India`;
                }
            }

            if (hasError) { firstEl.focus(); return; }

            const payBtn = document.querySelector('#step-form .donate-btn');
            payBtn.innerText = "Securing Connection...";
            payBtn.disabled = true;

            try {
                const apiBase = window.location.protocol === 'file:' ? 'https://phone-pe-pi.vercel.app' : '';
                const response = await fetch(`${apiBase}/api/create-link`, { 
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: name, amount: selectedAmt, phone: phone, email: email, seva: currentSeva, pan: finalPan, address: finalAddress })
                });

                const data = await response.json();
                if (data.payment_url) { window.location.href = data.payment_url; closeModal('payment-modal'); } 
                else { showToast('Error: ' + (data.error || 'Server rejected checkout setup')); }
            } catch (err) {
                showToast('Network error triggering gateway');
            } finally {
                payBtn.innerText = "Proceed to Payment"; payBtn.disabled = false;
            }
        }

        async function shareSecureReceipt() {
            const name = document.getElementById('r-name').innerText, amount = document.getElementById('r-amt').innerText, seva = document.getElementById('r-seva').innerText, txId = document.getElementById('r-txid').innerText, dateTime = document.getElementById('r-time').innerText;
            const shareText = `Hare Krishna! 🙏\nI have successfully offered a Seva Donation of ${amount} for "${seva}" at ISKCON Bhuvaikuntha.\n\nTransaction Details:\n• Donor: ${name}\n• Date: ${dateTime}\n• Tx ID: ${txId}\n\nMay the Deities bless you! 🌸`;
            if (navigator.share) {
                try { await navigator.share({ title: 'Donation Receipt', text: shareText }); } catch (err) {}
            } else {
                const temp = document.createElement('textarea');
                temp.value = shareText; document.body.appendChild(temp); temp.select(); document.execCommand('copy'); document.body.removeChild(temp);
                alert("Receipt details copied to clipboard!");
            }
        }

        function navigateToLiveDonations() { window.location.href = 'go:livedon'; openLiveDonationsModal(); }

        function openLiveDonationsModal() {
            const container = document.getElementById('live-donations-list'); container.innerHTML = '';
            if (globalLiveDonations.length === 0) {
                const lang = localStorage.getItem('lang') || 'en';
                container.innerHTML = `<div style="text-align:center; padding: 20px; color: #999;">${langData[lang]["no_donations"] || "No donations yet!"}</div>`;
            } else {
                globalLiveDonations.forEach(item => {
                    container.innerHTML += `
                        <div class="donation-item">
                            <div class="donor-details"><div class="donor-name">${escapeHtml(item.name)}</div><div class="donor-time">${item.date}</div></div>
                            <div class="donor-amt">₹${item.amount}</div>
                        </div>`;
                });
            }
            document.getElementById('live-modal').classList.remove('hidden');
        }

        function escapeHtml(text) { return !text ? '' : text.toString().replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;"); }

        function showToast(message) {
            const toast = document.getElementById('toast-notif'), tText = document.getElementById('toast-text');
            if (toast && tText) { tText.innerText = message; toast.classList.add('show'); setTimeout(() => toast.classList.remove('show'), 3500); } 
            else alert(message);
        }
    </script>
</body>
</html>
