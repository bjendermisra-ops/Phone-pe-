                "no_donations": "अभी तक कोई दान नहीं!", "share_title": "यह सेवा साझा करें", "link_copied": "सीधा सेवा लिंक कॉपी हो गया है! इसे व्हाट्सएप पर साझा करें।",
                "modal_tax_checkbox": "मुझे 10BE (आयकर लाभ) रसीद चाहिए", "modal_tax_subtext": "अपने सभी दानों के लिए कर-कटौती योग्य रसीदें प्राप्त करें",
                "modal_label_pan": "पैन नंबर*", "modal_label_address": "पता*", "modal_label_country": "देश*", "modal_label_state": "राज्य*",
