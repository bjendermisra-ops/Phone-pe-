                "btn_donate": "दान करें ❤", "card1_title": "गौ सेवा और चारा (गौ पोषण)", "card1_desc": "प्यारी गायों को प्रेमपूर्वक भोजन कराएं। आपका प्रसाद दैनिक रूप से ९०+ पवित्र गायों को पोषण देता है।",
                "card2_title": "गौ चिकित्सा (गौ चिकित्सा सेवा)", "card2_desc": "घायल and बीमार गायों के लिए आपातकालीन चिकित्सा देखभाल, नियमित जांच और उपचार का समर्थन करें।",
                "card3_title": "मार्बल सेवा प्रायोजित करें", "card3_desc": "संगमरमर प्रायोजित करके, आप उन पवित्र फर्शों और वेदियों को सजाने में मदद करते हैं जहां भगवान कृष्ण की पूजा की जाएगी।",
                "card4_title": "एकादशी विशेष सेवा (अन्नदान)", "card4_desc": "व्रत रखने वाले तीर्थयात्रियों और भक्तों के लिए विशेष अनाज-मुक्त भोजन प्रायोजित करें।",
                "view_live": "लाइव दान देखें", "modal_amt_title": "दान राशि चुनें", "modal_proceed_info": "दाता जानकारी पर आगे बढ़ें",
                "modal_donor_title": "दाता की जानकारी", "label_name": "पूरा नाम*", "label_phone": "मोबाइल नंबर*", "label_email": "ईमेल पता",
